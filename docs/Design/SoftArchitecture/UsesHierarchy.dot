// Uses hierarchy for the Keystone Module Guide (MG.tex, Section "Use Hierarchy
// Between Modules").
//
// An arrow A -> B means "A uses B": A needs a correct B to do its job.
// Arrows point down. Graphviz works out the layers on its own.
//
// The build renders this file to UsesHierarchy.pdf and fails if the graph has
// a cycle. Preview locally:  dot -Tpdf UsesHierarchy.dot -o UsesHierarchy.pdf

digraph UsesHierarchy {
  compound = true;     // lets an arrow start or end at a box (cluster)
  newrank = true;
  rankdir = TB;
  nodesep = 0.25;
  ranksep = 0.45;
  node [shape = box, style = "rounded,filled", fontname = "Helvetica", fontsize = 11];
  edge [arrowsize = 0.6, color = "#555555"];

  // ---------- Modules ----------
  // List each module once, after the colour for its type.

  // Behaviour-Hiding
  node [fillcolor = "#dce9f7"];
  M_UserInterface; M_Authentication; M_Authorization; M_CourseManagement;
  M_Notifications;

  // Request-handling modules (also Behaviour-Hiding). Every module in this box
  // uses the three modules the box's outgoing arrows point to.
  subgraph cluster_features {
    label = "Request-handling modules";
    fontname = "Helvetica"; fontsize = 11;
    style = "rounded,dashed"; color = "#888888";

    M_Projects; M_StudentsTeams; M_Recommendation; M_ApprovalWorkflow;
    M_Threads; M_Checklist; M_CourseReport; M_Enrollment;
  }

  // Software Decision
  node [fillcolor = "#fbe3c9"];
  M_Persistence; M_EmailDelivery; M_AuditLog;

  // Hardware-Hiding
  node [fillcolor = "#e4e4e4"];
  M_HardwareHiding;

  // ---------- Uses ----------
  // One line per module, listing the modules it uses:
  //   M_A -> { M_B M_C };

  M_UserInterface    -> { M_Authentication M_Authorization M_CourseManagement
                          M_HardwareHiding };
  // Into the box: M_UserInterface uses every request-handling module.
  M_UserInterface    -> M_Checklist [lhead = cluster_features];

  // Out of the box: every request-handling module uses these.
  M_Projects -> M_Authorization    [ltail = cluster_features];
  M_Projects -> M_CourseManagement [ltail = cluster_features];
  M_Projects -> M_AuditLog         [ltail = cluster_features];

  // Request-handling modules, beyond the shared uses above. Only modules that
  // keep their own records use M_Persistence; the others read records through
  // the modules that own them.
  M_Projects          -> { M_StudentsTeams M_Notifications M_Persistence };
  M_StudentsTeams     -> { M_Notifications M_Persistence };
  M_Recommendation    -> { M_StudentsTeams M_Projects };
  M_ApprovalWorkflow  -> { M_Projects M_StudentsTeams M_Notifications
                           M_Persistence M_HardwareHiding };
  M_Threads           -> { M_Projects M_StudentsTeams M_Notifications M_Persistence };
  M_Checklist         -> { M_Projects M_StudentsTeams M_ApprovalWorkflow
                           M_Notifications };
  M_CourseReport      -> { M_Projects M_StudentsTeams M_Authentication };
  M_Enrollment        -> { M_StudentsTeams M_Persistence M_HardwareHiding };

  // Other modules.
  M_Authentication    -> { M_Authorization M_AuditLog M_Persistence
                           M_HardwareHiding };
  M_Authorization     -> { M_AuditLog M_Persistence };
  M_CourseManagement  -> { M_AuditLog M_Persistence };
  M_Notifications     -> { M_Authentication M_Authorization M_EmailDelivery
                           M_Persistence M_HardwareHiding };

  M_EmailDelivery -> { M_AuditLog M_HardwareHiding };
  M_AuditLog      -> { M_Persistence };
  M_Persistence   -> { M_HardwareHiding };

  // ---------- Layout only (no effect on the uses relation) ----------
  // Rows, top to bottom. Keep each row to about four modules, and put every
  // module in a row below all the modules that use it, so arrows point down.
  // The invisible arrows keep the rows in this order.
  { rank = same; M_UserInterface; }
  { rank = same; M_Checklist; M_Recommendation; M_CourseReport; }
  { rank = same; M_ApprovalWorkflow; M_Threads; M_Enrollment; }
  { rank = same; M_Projects; }
  { rank = same; M_StudentsTeams; }
  { rank = same; M_Notifications; M_CourseManagement; }
  { rank = same; M_Authentication; M_EmailDelivery; }
  { rank = same; M_Authorization; }
  { rank = same; M_AuditLog; }
  { rank = same; M_Persistence; }
  { rank = same; M_HardwareHiding; }

  M_UserInterface -> M_Checklist -> M_ApprovalWorkflow -> M_Projects
    -> M_StudentsTeams -> M_Notifications -> M_Authentication
    -> M_Authorization -> M_AuditLog -> M_Persistence -> M_HardwareHiding
    [style = invis];
}
